{
  "name": "minni-birthday-frozen-surprise",
  "version": "1.0.0",
  "description": "An enchanted, photorealistic Frozen-themed birthday surprise web app for Minni",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "server": "node server/index.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently --kill-others -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"node server/index.js\" \"npm --prefix client run dev\"",
    "build": "npm --prefix client install && npm --prefix client run build",
    "start": "node server/index.js",
    "docker:build": "docker build -t minni-frozen-surprise .",
    "docker:run": "docker run -d -p 5000:5000 --name minni-frozen-surprise minni-frozen-surprise",
    "docker:stop": "docker stop minni-frozen-surprise && docker rm minni-frozen-surprise",
    "docker:compose": "docker compose up -d --build",
    "docker:compose:down": "docker compose down"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
